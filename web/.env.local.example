# Copy to .env.local and fill in. Without a key the assistant runs in offline rule-based mode.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=placeholder_for_your_api_key
# Optional: models tried in order; on a free-tier 429 the agent moves to the next one.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash
CV_SERVICE_URL=http://127.0.0.1:8001
